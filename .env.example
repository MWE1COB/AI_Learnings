# Copy this file to ".env" and fill in real values. ".env" is git-ignored and
# its file permissions are auto-restricted to your Windows account at runtime.

BOSCH_AOAI_ENDPOINT=https://aoai-farm.bosch-temp.com/api
BOSCH_AOAI_MODEL=askbosch-prod-farm-openai-gpt-4o-mini-2024-07-18
BOSCH_AOAI_API_VERSION=2024-08-01-preview
BOSCH_AOAI_API_KEY=
# Leave empty to bypass the system proxy, or set an explicit proxy URL.
BOSCH_AOAI_PROXY=

# Optional per-machine overrides for the demo_quiz admin dashboard/export
# password (only needed if you're running a shared build of DemoQuiz.exe
# built on someone else's machine). Enter plaintext here once; it gets
# encrypted in place on first run, same as BOSCH_AOAI_API_KEY above.
DEMO_ADMIN_PASSWORD=
DEMO_EXPORT_PASSWORD=

# demo_quiz admin dashboard/export passwords are no longer stored here.
# Run `python demo_quiz/admin_secrets.py` and follow the prompt to set them;
# the encrypted output is stored in demo_quiz/admin_secrets.py instead.
